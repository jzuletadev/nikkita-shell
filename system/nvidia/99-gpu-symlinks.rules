# ~/nikita-shell/system/nvidia/99-gpu-symlinks.rules
# Stable names for the GPUs, by VENDOR (a PCI address can change between boots):
# /dev/dri/amd-igpu or intel-igpu, and nvidia-dgpu. For DRI_PRIME and for launching
# something on a given card; Hyprland itself finds them by driver (env-hyprland).
KERNEL=="card*", SUBSYSTEM=="drm", SUBSYSTEMS=="pci", ATTRS{vendor}=="0x1002", SYMLINK+="dri/amd-igpu"
KERNEL=="card*", SUBSYSTEM=="drm", SUBSYSTEMS=="pci", ATTRS{vendor}=="0x8086", SYMLINK+="dri/intel-igpu"
KERNEL=="card*", SUBSYSTEM=="drm", SUBSYSTEMS=="pci", ATTRS{vendor}=="0x10de", SYMLINK+="dri/nvidia-dgpu"

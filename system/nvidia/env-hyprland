# ~/nikkita-shell/system/nvidia/env-hyprland

# By DRIVER, which is stable. The integrated GPU goes first because it drives the panel
# and should draw the desktop; the dedicated one stays behind for whoever asks for it.

__igpu=""
__dgpu=""
for __card in /sys/class/drm/card[0-9]*; do
    [ -e "$__card/device/uevent" ] || continue
    case "$(sed -n 's/^DRIVER=//p' "$__card/device/uevent")" in
        amdgpu|i915|xe) __igpu="/dev/dri/${__card##*/}" ;;
        nvidia)         __dgpu="/dev/dri/${__card##*/}" ;;
    esac
done

# If there is only one, use it; if there is none, leave the variable alone and let Hyprland choose.
__aq="${__igpu}${__igpu:+${__dgpu:+:}}${__dgpu}"
[ -n "$__aq" ] && export AQ_DRM_DEVICES="$__aq"
unset __igpu __dgpu __aq __card
